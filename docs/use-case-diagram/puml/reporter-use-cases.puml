@startuml Reporter Use Cases

left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
    BackgroundColor #E3F2FD
    BorderColor #2196F3
}

actor "Reporter" as Reporter

rectangle "Emergency Pin-Alert System" {

    package "Authentication" {
        usecase "Register" as UC1
        usecase "Login" as UC2
        usecase "Manage Profile" as UC3
    }

    package "Incident Reporting" {
        usecase "Create Incident Report" as UC4
        usecase "Auto GPS Location" as UC5
        usecase "Upload Evidence" as UC6
        usecase "Track Incident Status" as UC7
    }

    package "Communication" {
        usecase "Chat in Incident Room" as UC14
    }

    package "User Report" {
        usecase "Report Staff Behavior" as UC15
    }
}

Reporter --> UC1
Reporter --> UC2
Reporter --> UC3
Reporter --> UC4
Reporter --> UC7
Reporter --> UC14
Reporter --> UC15

UC4 ..> UC5 : <<include>>
UC6 ..> UC4 : <<extend>>

@enduml
